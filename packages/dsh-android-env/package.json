{
  "name": "dsh-android-env",
  "version": "1.0.0",
  "description": "DSH Mobile's Android environment manual, delivered as ordered systemPrompt sections instead of a seeded AGENTS.md.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./sections/*": "./sections/*"
  },
  "files": [
    "index.js",
    "sections"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-system-prompt": "*"
  },
  "dsh": {
    "android": {
      "assetDir": "android-plugins/android-env",
      "entry": "index.js"
    }
  }
}
