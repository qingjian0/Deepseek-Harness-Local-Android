#!/system/bin/sh
# [dsh-android] 自举到引擎 bash（/dev/tcp 是 bash 特性，toybox sh 不支持）。
# shebang 机制不传环境变量，故显式设 LD_LIBRARY_PATH 后 exec；
# _DSH_REEXEC 标记防止 exec "$0" 造成无限递归。
if [ -z "$_DSH_REEXEC" ]; then
  _DSH_REEXEC=1; export _DSH_REEXEC
  LD_LIBRARY_PATH="@DSH_LIBDIR@${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; export LD_LIBRARY_PATH
  exec "@DSH_BASH@" "$0" "$@"
fi
# [dsh-android] parallel: 委托任务给常驻规划守护进程（边规划边行动）
#
# 为什么给 agent 这个工具：对话流是请求-响应模型——**你推理时无法执行工具**，
# 所以「边规划边行动」在对话轮内天然做不到。本工具把「任务 + 成功条件」
# 投递给**独立于对话轮**的常驻守护进程（planner-daemon），它自己循环：
#   读屏 → 规划（DeepSeek）→ 本地闭环执行（loop）→ 看结果 → 再规划
# 直到达成 / 步数上限 / 预算耗尽。委托后你立即解放，可轮询进度或做别的事。
#
#   run "<goal>" [--success "<条件>"] [--max-steps N]   委托任务（立即返回 task id）
#   status [<id>]      查看进度（默认最近任务）：状态/步数/最近执行摘要
#   log [<id>]         日志尾部（规划决策 + 执行摘要，排障用）
#   stop [<id>]        请求停止
#   list               列出最近任务
#
# 典型用法：
#   parallel run "打开设置并把深色主题打开" --success "深色主题开关为开启状态"
#   parallel status        # 轮询直到 status=done/failed
#   parallel log           # 需要看细节时
#
# 注意：成功条件要写「可验证的目标状态」（如"开关为开"），不要写动作描述。
DIR=$(cd "$(dirname "$0")" && pwd)
. "$DIR/_dsh_http.sh"

DSH_HOME="${DSH_HOME:-/data/user/0/dsh.dsh.mobile/files/dsh-home}"
TASKS="$DSH_HOME/tasks"
QUEUE="$TASKS/queue"
DAEMON="$DSH_HOME/tools/planner-daemon.mjs"
NODE="${PREFIX:-$(dirname "$DIR")}/bin/node"

ensure_daemon() {
  if ! pgrep -f planner-daemon.mjs >/dev/null 2>&1; then
    mkdir -p "$QUEUE"
    nohup "$NODE" "$DAEMON" >/dev/null 2>&1 &
    sleep 1
  fi
}

latest_id() {
  ls -t "$TASKS"/*.json 2>/dev/null | head -1 | sed 's|.*/||; s|\.json$||'
}

case "$1" in
  run)
    # v1.2.158（用户点名要防的"乌龙"）：daemon 需要 API key（由「无障碍 max+」开关
    # 写入 $DSH_HOME/.credentials.yaml 的 refs 段）。若 max+ 没开，这里**明确拒绝**，
    # 而不是让任务悄悄派出去、daemon 拿不到 key 后空转/静默失败——
    # 那样 AI 会以为任务在跑，用户等半天没结果。
    if ! grep -q "DEEPSEEK_API_KEY" "${DSH_HOME:-/data/user/0/dsh.dsh.mobile/files/dsh-home}/.credentials.yaml" 2>/dev/null; then
      echo '{"ok":false,"error":"accessibility max+ is OFF — the daemon needs an API key it cannot get. Ask the user to enable Settings -> Extensions -> Accessibility max+ (one sentence), then delegate again; meanwhile do the task yourself with short `loop run` plans."}'
      exit 3
    fi
    shift
    GOAL="$1"; shift
    [ -n "$GOAL" ] || { echo "usage: parallel run \"<goal>\" [--success \"...\"] [--max-steps N]" >&2; exit 64; }
    SUCCESS=""; MAX=15
    while [ $# -gt 0 ]; do
      case "$1" in
        --success) SUCCESS="$2"; shift 2 ;;
        --max-steps) MAX="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    [ -n "$SUCCESS" ] || SUCCESS="$GOAL"
    mkdir -p "$QUEUE"
    ID="t$(date +%s%3N)"
    BODY="{\"id\":\"$ID\",\"goal\":\"$(_dsh_json_escape "$GOAL")\",\"success\":\"$(_dsh_json_escape "$SUCCESS")\",\"maxSteps\":$MAX}"
    printf '%s' "$BODY" > "$QUEUE/$ID.json"
    ensure_daemon
    echo "{\"ok\":true,\"task\":\"$ID\",\"hint\":\"poll: parallel status $ID\"}"
    ;;
  status)
    ID="$2"; [ -n "$ID" ] || ID="$(latest_id)"
    [ -n "$ID" ] || { echo '{"ok":false,"error":"no tasks yet"}'; exit 1; }
    cat "$TASKS/$ID.json" 2>/dev/null || { echo "{\"ok\":false,\"error\":\"task $ID not found\"}"; exit 1; }
    ;;
  log)
    ID="$2"
    if [ -z "$ID" ]; then
      ID=$(ls -t "$TASKS"/*.log 2>/dev/null | head -1 | sed 's|.*/||; s|\.log$||')
    fi
    [ -n "$ID" ] || { echo "no task logs"; exit 1; }
    tail -40 "$TASKS/$ID.log" 2>/dev/null || echo "no log for $ID"
    ;;
  stop)
    ID="$2"; [ -n "$ID" ] || ID="$(latest_id)"
    [ -n "$ID" ] || { echo "usage: parallel stop <id>" >&2; exit 64; }
    touch "$TASKS/$ID.stop"
    echo "{\"ok\":true,\"stopRequested\":\"$ID\"}"
    ;;
  list)
    ls -t "$TASKS"/*.json 2>/dev/null | head -10 | sed 's|.*/||; s|\.json$||'
    ;;
  *)
    sed -n '11,28p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
